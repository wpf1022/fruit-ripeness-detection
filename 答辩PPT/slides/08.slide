<Slide style={{ width: 1280, height: 720, padding: 0, background: '#FFFFFF', position: 'relative' }}>
  <Box style={{ position: 'absolute', left: 0, top: 0, width: 1280, height: 72, background: '#0E3F8C', paddingLeft: 40, paddingRight: 40, flexDirection: 'row', alignItems: 'center' }}>
    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF' }}>创新点三：用弱监督补齐柿子成熟度数据</Text>
  </Box>
  <Box style={{ position: 'absolute', left: 0, top: 72, width: 1280, height: 2, background: '#3D7BD9' }} />

  <Box style={{ position: 'absolute', left: 40, top: 100, width: 1200, height: 140, flexDirection: 'row', gap: 30 }}>
    <Box style={{ width: 216, height: 140, background: '#F0F5FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: 14 }}>
      <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E4FA8' }}>01 选取 Kaki</Text>
      <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.45, marginTop: 10 }}>从 Fruits-360 提取柿子样本。</Text>
    </Box>
    <Box style={{ width: 216, height: 140, background: '#F0F5FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: 14 }}>
      <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E4FA8' }}>02 前景分割</Text>
      <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.45, marginTop: 10 }}>用饱和度掩码提取果实区域。</Text>
    </Box>
    <Box style={{ width: 216, height: 140, background: '#E8EFF8', border: '1px solid #3D7BD9', borderRadius: 10, padding: 14 }}>
      <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C' }}>03 色相扰动</Text>
      <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.45, marginTop: 10 }}>模拟高、中、低成熟的颜色差异。</Text>
    </Box>
    <Box style={{ width: 216, height: 140, background: '#F0F5FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: 14 }}>
      <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E4FA8' }}>04 背景粘贴</Text>
      <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.45, marginTop: 10 }}>贴到模糊背景，增加场景变化。</Text>
    </Box>
    <Box style={{ width: 216, height: 140, background: '#F0F5FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: 14 }}>
      <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E4FA8' }}>05 自动 bbox</Text>
      <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.45, marginTop: 10 }}>由前景区域计算 YOLO 检测框。</Text>
    </Box>
  </Box>

  <Box style={{ position: 'absolute', left: 40, top: 270, width: 1200, height: 300, flexDirection: 'row', gap: 30 }}>
    <Box style={{ width: 380, height: 300, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: 12 }}>
      <Image src="assets/persimmon_high.jpg" style={{ width: 354, height: 210, objectFit: 'cover', borderRadius: 6 }} />
      <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C', lineHeight: 1.4, marginTop: 8 }}>高成熟柿子</Text>
      <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.3 }}>自然深橙色样本</Text>
    </Box>
    <Box style={{ width: 380, height: 300, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: 12 }}>
      <Image src="assets/persimmon_mid.jpg" style={{ width: 354, height: 210, objectFit: 'cover', borderRadius: 6 }} />
      <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C', lineHeight: 1.4, marginTop: 8 }}>中成熟柿子</Text>
      <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.3 }}>黄橙色扰动样本</Text>
    </Box>
    <Box style={{ width: 380, height: 300, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: 12 }}>
      <Image src="assets/persimmon_low.jpg" style={{ width: 354, height: 210, objectFit: 'cover', borderRadius: 6 }} />
      <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C', lineHeight: 1.4, marginTop: 8 }}>低成熟柿子</Text>
      <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.3 }}>黄绿色扰动样本</Text>
    </Box>
  </Box>

  <Box style={{ position: 'absolute', left: 40, top: 594, width: 1200, height: 46, background: '#E8EFF8', borderRadius: 8, padding: 12, justifyContent: 'center' }}>
    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0E3F8C', lineHeight: 1.4 }}>诚实边界：这是弱监督生成数据，不是真实人工标注；它能补齐类别，但真实光照与采摘场景仍需实拍验证。</Text>
  </Box>

  <Box style={{ position: 'absolute', left: 40, top: 668, width: 700, height: 24 }}><Text style={{ fontSize: 14, color: '#8B97A8' }}>水果成熟度智能分级与检测系统</Text></Box>
  <Box style={{ position: 'absolute', right: 40, top: 668, width: 120, height: 24 }}><Text style={{ fontSize: 14, color: '#1E4FA8', textAlign: 'right' }}>08 / 12</Text></Box>
</Slide>
