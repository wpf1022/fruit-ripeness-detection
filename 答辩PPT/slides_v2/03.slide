      <Text style={{ fontSize: 20, color: '#4A5568', marginTop: 4 }}>张训练图</Text>
    </Box>
    <Box style={{ width: 285, height: 130, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, justifyContent: 'center', alignItems: 'center' }}>
      <Text style={{ fontSize: 52, fontWeight: 'bold', color: '#1E4FA8' }}>734</Text>
      <Text style={{ fontSize: 20, color: '#4A5568', marginTop: 4 }}>张验证图</Text>
    </Box>
    <Box style={{ width: 285, height: 130, background: '#E8EFF8', border: '1px solid #3D7BD9', borderRadius: 10, justifyContent: 'center', alignItems: 'center' }}>
      <Text style={{ fontSize: 52, fontWeight: 'bold', color: '#0E3F8C' }}>16</Text>
      <Text style={{ fontSize: 20, color: '#4A5568', marginTop: 4 }}>类检测标签</Text>
